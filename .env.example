# Choose: openai, azure, or phi4
BILL_AGENT_PROVIDER=openai

# Public OpenAI
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=replace-with-your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Choose responses or chat_completions based on the deployment.
AZURE_OPENAI_API=responses

# Local Microsoft Phi-4 through Ollama
PHI4_BASE_URL=http://localhost:11434/v1
PHI4_MODEL=phi4-mini
PHI4_API_KEY=ollama

# Local semantic-search experiment
OLLAMA_BASE_URL=http://localhost:11434
BILL_EMBEDDING_MODEL=qwen3-embedding:4b
